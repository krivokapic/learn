main: $(BIN_DIR)/main.o $(BIN_DIR)/engine.o $(BIN_DIR)/nn.o $(BIN_DIR)/arena.o
	@gcc $(CFLAGS) $^ -o $(BIN_DIR)/main

$(BIN_DIR)/main.o: $(SRC_DIR)/main.c $(SRC_DIR)/engine.h $(SRC_DIR)/nn.h
	@gcc $(CFLAGS) -c $(SRC_DIR)/main.c -o $(BIN_DIR)/main.o

$(BIN_DIR)/engine.o: $(SRC_DIR)/engine.c $(SRC_DIR)/engine.h
	@gcc $(CFLAGS) -c $(SRC_DIR)/engine.c -o $(BIN_DIR)/engine.o

$(BIN_DIR)/nn.o: $(SRC_DIR)/nn.c $(SRC_DIR)/engine.h $(SRC_DIR)/nn.h
	@gcc $(CFLAGS) -c $(SRC_DIR)/nn.c -o $(BIN_DIR)/nn.o

