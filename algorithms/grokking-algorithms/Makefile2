CFLAGS := -fsanitize=address,leak -lm -g3 -O1 -std=gnu11 -Wall -Wextra -Wpedantic -Werror -Wconversion -pedantic
SRC_DIR := $(CURDIR)/src
BIN_DIR := $(CURDIR)/bin

