$(BIN_DIR)/arena.o: $(SRC_DIR)/arena.c $(SRC_DIR)/arena.h $(SRC_DIR)/base.h
	@gcc $(CFLAGS) -c $(SRC_DIR)/arena.c -o $(BIN_DIR)/arena.o

